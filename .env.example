# Resend configuration for the student welcome-letter email.
RESEND_API_KEY=
WELCOME_LETTER_FROM="DBS Kaduna <welcome@example.com>"

# Server-only automated notification worker. Keep sending disabled outside production.
DISCOVER_BIBLE_SCHOOL_EMAIL_FROM="DBS Kaduna <notifications@example.com>"
DISCOVER_BIBLE_SCHOOL_EMAIL_REPLY_TO=help@example.com
DISCOVER_BIBLE_SCHOOL_APP_URL=https://your-domain.example
DISCOVER_BIBLE_SCHOOL_EMAIL_ENABLED=false
NOTIFICATION_WORKER_SECRET=
# Vercel Cron uses this value when invoking the scheduled worker.
CRON_SECRET=

# Public browser configuration for secure dashboards and communication.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Zoom Marketplace OAuth and webhook configuration. Never prefix these with VITE_.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://your-domain.example/api/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
# Generate with: openssl rand -base64 32
ZOOM_TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=https://your-domain.example
